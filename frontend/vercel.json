{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "frontend-phi-five-jmn7bl1xem.vercel.app"
        }
      ],
      "destination": "https://osda-ai.vercel.app/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "frontend-phi-five-jmn7bl1xem.vercel.app"
        }
      ],
      "destination": "https://osda-ai.vercel.app/:path*",
      "permanent": true
    }
  ]
}
