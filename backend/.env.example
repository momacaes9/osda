# ---------- Server ----------
PORT=3000
# Comma-separated list of allowed frontend origins (empty = allow all)
CORS_ORIGIN=http://localhost:5173

# ---------- Database (PostgreSQL) ----------
# Local (docker compose up -d):
DATABASE_URL=postgres://osda:osda@localhost:5432/osda
# Hosted (Neon / Supabase / Vercel Marketplace) usually needs SSL:
DATABASE_SSL=false
# Optional schema (use a private one like "osda" on Supabase)
DATABASE_SCHEMA=
# Auto-create tables from the TypeORM entities
DATABASE_SYNCHRONIZE=true

# ---------- Auth ----------
# Generate one with: openssl rand -hex 32
JWT_SECRET=change-me
JWT_ACCESS_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=86400
BCRYPT_SALT_ROUNDS=12

# ---------- AI (automatic fallback chain) ----------
# The API tries every configured model in this order and automatically switches to the
# next one when a provider fails, hits a rate limit or runs out of credits:
#   AI_API_KEY/OPENAI → Groq → Gemini → OpenRouter → Vercel AI Gateway → Pollinations (free, no key) → offline
# With NO keys at all, the free keyless Pollinations model is used. Add free keys for better quality.

# OpenAI (ChatGPT) or any OpenAI-compatible API
# AI_API_KEY=sk-...
# AI_BASE_URL=
# AI_MODEL=gpt-4.1-nano            # comma-separated list allowed

# Groq — free (https://console.groq.com/keys)
# GROQ_API_KEY=gsk_...
# GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant

# Google Gemini — free (https://aistudio.google.com/apikey)
# GEMINI_API_KEY=AIza...
# GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite

# OpenRouter — free models (https://openrouter.ai/keys)
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free,openrouter/free

# Vercel AI Gateway (needs a card on file in Vercel to unlock free credits)
# AI_GATEWAY_API_KEY=...
# AI_GATEWAY_MODELS=openai/gpt-4.1-nano,google/gemini-2.5-flash-lite

# Pollinations — free, no key (last online fallback). Set to true to turn it off.
# AI_DISABLE_KEYLESS=false
# AI_TIMEOUT_MS=35000            # chat
# AI_ANALYSIS_TIMEOUT_MS=60000   # questionnaire analysis
