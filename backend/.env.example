# ---------- Server ----------
PORT=3000
# Comma-separated list of allowed frontend origins (empty = allow all)
CORS_ORIGIN=http://localhost:5173

# ---------- Database (PostgreSQL) ----------
# Local (docker compose up -d):
DATABASE_URL=postgres://osda:osda@localhost:5432/osda
# Hosted (Neon / Supabase / Vercel Marketplace) usually needs SSL:
DATABASE_SSL=false
# Auto-create tables from the TypeORM entities
DATABASE_SYNCHRONIZE=true

# ---------- Auth ----------
# Generate one with: openssl rand -hex 32
JWT_SECRET=change-me
JWT_ACCESS_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=86400
BCRYPT_SALT_ROUNDS=12

# ---------- AI (pick ONE option, or leave all empty for the built-in offline assistant) ----------
# Option 1 — OpenAI (ChatGPT): gpt-4.1-nano
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4.1-nano

# Option 2 — Free OpenAI-compatible API, e.g. Groq (https://console.groq.com/keys)
# AI_API_KEY=gsk_...
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.3-70b-versatile

# Option 3 — Free: Google Gemini (https://aistudio.google.com/apikey)
# AI_API_KEY=AIza...
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-2.5-flash

# Option 4 — Free models on OpenRouter (https://openrouter.ai/keys)
# AI_API_KEY=sk-or-...
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Option 5 — Vercel AI Gateway (works automatically on Vercel via OIDC, or set a key)
# AI_GATEWAY_API_KEY=...
# AI_MODEL=openai/gpt-4.1-nano
